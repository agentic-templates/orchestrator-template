{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "orchestrator",
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(git push *)",
      "Bash(git worktree *)",
      "Bash(gh issue close *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue edit *)",
      "Bash(gh pr close *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr review *)",
      "Bash(scripts/*)",
      "Bash(uv *)",
      "Bash(uvx *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(/.loop/agents.env)",
      "Bash(sudo *)",
      "Bash(pkill *)",
      "Bash(killall *)",
      "Bash(gh auth token *)",
      "Bash(gh issue create *)",
      "Bash(gh pr merge *)",
      "Bash(git config --global *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "enableWeakerNetworkIsolation": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "pypi.org",
        "files.pythonhosted.org"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": ".env",
          "mode": "deny"
        },
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.aws",
          "mode": "deny"
        }
      ]
    }
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "subagentPromptCacheTtl": "1h",
  "autoCompactEnabled": false,
  "idleCompaction": false,
  "statusLine": {
    "type": "command",
    "command": "cd \"${LOOP_ROOT:-$CLAUDE_PROJECT_DIR}\" && exec env -u UV_CACHE_DIR -u UV_TOOL_DIR scripts/hooks/status-line"
  },
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "30000",
    "BASH_MAX_TIMEOUT_MS": "60000"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr create *)",
            "command": "cd \"${LOOP_ROOT:-$CLAUDE_PROJECT_DIR}\" && exec env -u UV_CACHE_DIR -u UV_TOOL_DIR scripts/hooks/auto-merge"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${LOOP_ROOT:-$CLAUDE_PROJECT_DIR}\" && exec env -u UV_CACHE_DIR -u UV_TOOL_DIR scripts/hooks/session-start skills claude"
          },
          {
            "type": "command",
            "command": "cd \"${LOOP_ROOT:-$CLAUDE_PROJECT_DIR}\" && exec env -u UV_CACHE_DIR -u UV_TOOL_DIR scripts/hooks/session-start state"
          },
          {
            "type": "command",
            "command": "cd \"${LOOP_ROOT:-$CLAUDE_PROJECT_DIR}\" && exec env -u UV_CACHE_DIR -u UV_TOOL_DIR scripts/hooks/session-start status"
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${LOOP_ROOT:-$CLAUDE_PROJECT_DIR}\" && [ -d .loop/notices ] && exec env -u UV_CACHE_DIR -u UV_TOOL_DIR scripts/hooks/notices || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${LOOP_ROOT:-$CLAUDE_PROJECT_DIR}\" && exec env -u UV_CACHE_DIR -u UV_TOOL_DIR scripts/hooks/maintainer"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${LOOP_ROOT:-$CLAUDE_PROJECT_DIR}\" && exec env -u UV_CACHE_DIR -u UV_TOOL_DIR scripts/hooks/watcher"
          },
          {
            "type": "command",
            "command": "cd \"${LOOP_ROOT:-$CLAUDE_PROJECT_DIR}\" && [ -f .loop/refresh-request ] && exec env -u UV_CACHE_DIR -u UV_TOOL_DIR scripts/hooks/refresh || true"
          }
        ]
      }
    ]
  }
}
