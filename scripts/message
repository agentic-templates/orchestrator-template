#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.12"
# ///
"""Sends a message to an agent that scripts/launch started. The agent reads it after its current tool call.

usage: scripts/message <agent ID> <message>

scripts/status lists the running agents with their IDs.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent / "lib"))
import launching
import usage


def main() -> int:
    if len(sys.argv) != 3:
        print(__doc__)
        return 2
    agent_id, message = sys.argv[1], sys.argv[2]
    input_path = usage.AGENTS / f"{agent_id}.input"
    if not input_path.exists():
        print(f"{agent_id} isn't running. scripts/status lists the agents that are.")
        return 1
    launching.send(input_path, message)
    print(f"Sent to {agent_id}.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
