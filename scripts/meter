#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.12"
# ///
"""Says for each account whether to start agents on it, hold, or wind them down, and which account to use next.

usage: scripts/meter

It reads each account's usage from .loop/usage/, and takes a fresh reading of an account whose last one is old,
or that agents started on since. When agents must wind down, it tells the newest ones first, through a notice
that the notice hook shows them. The orchestrator's account is used last. An account in .loop/accounts.json can set
"reserve", the percent of each window that the loop leaves alone for your own use, such as 20. scripts/watch runs
the same decisions every minute.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent / "lib"))
import metering
import usage

if __name__ == "__main__":
    print(metering.report(metering.decisions(), usage.accounts()))
