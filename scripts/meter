#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.12"
# ///
"""Says for each account whether to start agents on it, hold, or wind them down, and which account to use next.

usage: scripts/meter

It reads each account's usage from .loop/usage/, and takes a fresh reading of an account whose last one is old,
or that agents started on since. When agents must wind down, it tells the newest ones first, through a notice
that the notice hook shows them. The orchestrator's account is used last, and keeps a reserve for the
orchestrator. scripts/watch runs the same decisions every minute.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent / "lib"))
import metering

if __name__ == "__main__":
    print(metering.report(metering.decisions()))
