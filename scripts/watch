#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.12"
# ///
"""Watches the loop every minute, and exits with a report when something needs the orchestrator.

usage: scripts/watch

The orchestrator runs it in the background, and its exit wakes the orchestrator. Every minute it:

- runs the meter's decisions for every account, and tells agents to wind down when an account nears its limit
- tells each session to hand off or refresh once a fresh one would cost less, and winds everything down when a
  session nears its context limit
- retries a refresh that hasn't happened, once, and has the orchestrator tell the maintainer if the retry fails too
- reports pull requests that merged, opened or failed their checks, and agents that have done nothing for a while
- reports when main's checks start to fail
- ends agents whose launcher has exited, such as after a crash

It also exits 50 minutes after the orchestrator's last turn, so that its prompt cache, which lasts an hour, stays
warm.
"""

import json
import os
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent / "lib"))
import metering
import usage
import watching


def check(state: dict) -> list[str]:
    usage.end_orphans()
    events = watching.meter_changes(state, metering.decisions())
    events += watching.check_contexts()
    events += watching.check_refresh(state)
    events += watching.check_pull_requests(state)
    events += watching.check_main(state)
    events += watching.check_stalled(state)
    return events


def main() -> int:
    if (running := usage.pid_in(watching.PID)) and usage.is_running(running, "watch"):
        print(f"scripts/watch runs already, as process {running}. Its exit wakes you, so you don't need another.")
        return 0
    watching.PID.write_text(str(os.getpid()))
    try:
        return watch()
    finally:
        watching.PID.unlink(missing_ok=True)


def watch() -> int:
    started = time.time()
    state = watching.load_state()
    while time.time() < watching.warm_wake_at(started):
        time.sleep(metering.CHECK_SECONDS)
        events = check(state)
        usage.write_atomically(watching.STATE, json.dumps(state))
        if events:
            print("\n".join(events) + "\n\n" + metering.report(metering.decisions(), usage.accounts()))
            return 0
    print(
        "Warm wake: 50 minutes passed without anything new.\n\n"
        + metering.report(metering.decisions(), usage.accounts())
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
