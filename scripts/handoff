#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.12"
# ///
"""Saves a builder's hand-off note, where the builder after it on the same issue will find it.

usage: scripts/handoff <issue> <file>

The note goes to .loop/handoff/issue-<issue>.md in the main checkout, wherever the builder runs, and replaces any
earlier note for the issue.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent / "lib"))
import usage


def main() -> int:
    if len(sys.argv) != 3:
        print(__doc__)
        return 2
    folder = usage.LOOP / "handoff"
    folder.mkdir(parents=True, exist_ok=True)
    note = folder / f"issue-{int(sys.argv[1])}.md"
    note.write_text(Path(sys.argv[2]).read_text())
    print(f"Saved the hand-off note to {note}.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
