#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.12"
# ///
"""Shows where the loop stands: its worktrees, open pull requests and the agents that scripts/launch started.

usage: scripts/status [--save]

With --save, it also commits and pushes the work that stopped builders left, and removes the worktrees no agent
needs. It touches only the worktrees in .loop/worktrees, never your own.
"""

import argparse
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent / "lib"))
import github
import launching
import usage
import watching

ROOT = Path(__file__).resolve().parent.parent
AGENTS = ROOT / ".loop" / "agents"


def git(*args: str, cwd: Path = ROOT) -> str:
    return subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True, check=True).stdout.strip()


def running_agents() -> dict[str, dict]:
    """The agents that scripts/launch started and that still run, by their worktree."""
    return {agent["worktree"]: agent for agent in usage.running_agents()}


def worktrees() -> list[dict]:
    """The worktrees that scripts/launch made for agents. The maintainer's own worktrees are left alone."""
    result, current = [], {}
    for line in git("worktree", "list", "--porcelain").splitlines() + [""]:
        if not line:
            if current and Path(current["worktree"]).parent == launching.WORKTREES:
                result.append(current)
            current = {}
        else:
            key, _, value = line.partition(" ")
            current[key] = value
    return result


def changed_files(changed: list[str]) -> str:
    return f"{len(changed)} changed file" if len(changed) == 1 else f"{len(changed)} changed files"


def tend_worktree(tree: dict, running: dict, save: bool) -> str:
    """The worktree's line in the status, or nothing for a worktree it removed."""
    path = Path(tree["worktree"])
    branch = tree.get("branch", "").removeprefix("refs/heads/")
    if path.as_posix() in running:
        return f"- {branch or path.name}: {running[path.as_posix()]['name']} is working in it"
    if "prunable" in tree:
        if save:
            launching.remove_worktree(path)
            return ""
        return f"- {path.name}: its folder is gone"
    nested = launching.nested_repositories(path)
    changed = launching.changes(path, nested).splitlines()
    if not branch:
        # A builder that stopped in the middle of a rebase has no branch either, and its work must stay.
        if save and not is_builders(path):
            launching.remove_worktree(path)
            return ""
        return f"- {path.name}: no agent"
    try:
        merged = launching.is_merged(path, branch)
    except SystemExit as failure:
        return (
            f"- {branch}: GitHub couldn't say whether it merged, so nothing was saved or removed: {failure}. Your next "
            "session start tries again."
        )
    if merged:
        if changed:
            return f"- {launching.merged_leftovers(branch, path)}"
        if save:
            launching.remove_worktree(path)
            return ""
        return f"- {branch}: merged, no agent"
    if save and (changed or launching.unpushed(path)):
        if error := launching.save_work(path):
            return f"- {branch}: its builder stopped, and its work isn't on GitHub yet. {launching.push_advice(error, path)}"
        pushed = f"- {branch}: its builder stopped, and its work is pushed. Continue it with --successor."
        return " ".join(filter(None, [pushed, launching.left_out(nested)]))
    if changed:
        return f"- {branch}: {changed_files(changed)}, no agent"
    if commits := launching.unpushed(path):
        return f"- {branch}: no agent, and {commits} of its commits aren't on GitHub yet"
    return f"- {branch}: no agent"


def is_builders(worktree: Path) -> bool:
    """Whether a builder worked in the worktree, as far as anyone knows. The launcher names it after the agent."""
    record = usage.agent_record(worktree.name)
    return record is None or launching.built(record)


def tend_worktrees(save: bool) -> list[str]:
    """One line for each worktree. A worktree that fails gets its error, and the others are still tended."""
    lines = []
    with launching.git_lock():
        # Read once the lock is held, so that an agent that started meanwhile counts as running.
        running = running_agents()
        for tree in worktrees():
            try:
                if line := tend_worktree(tree, running, save):
                    lines.append(line)
            except subprocess.CalledProcessError as error:
                lines.append(f"- {Path(tree['worktree']).name}: {(error.stderr or str(error)).strip()}")
    return lines


def pull_requests() -> list[str]:
    fields = "number,title,isDraft,autoMergeRequest,statusCheckRollup,reviews"
    prs = github.gh_json("pr", "list", "--limit", str(watching.PULL_REQUEST_LIMIT), "--json", fields)
    lines = []
    for pr in prs or []:
        checks = watching.checks_state(pr)
        merge = "draft" if pr["isDraft"] else "auto-merge on" if pr["autoMergeRequest"] else "auto-merge off"
        lines.append(f"- #{pr['number']} {pr['title']}: checks {checks}, {merge}, {len(pr['reviews'])} reviews")
    return lines


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument(
        "--save", action="store_true", help="save the work of stopped builders, and remove worktrees no agent needs"
    )
    arguments = parser.parse_args()
    if arguments.save:
        usage.end_orphans()
    print("## Running agents")
    agents = usage.running_agents()
    print("\n".join(f"- {a['id']}: {a['name']} on #{a['number']}, account {a['account']}" for a in agents) or "None")
    print("\n## Worktrees")
    print("\n".join(tend_worktrees(arguments.save)) or "None")
    print("\n## Open pull requests")
    try:
        print("\n".join(pull_requests()) or "None")
    except SystemExit as failure:
        print(f"Couldn't list them: {failure}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
