#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.12"
# ///
"""The orchestrator's editor for Ctrl+G, which scripts/orchestrate sets as EDITOR and VISUAL.

usage: scripts/editor <file>

When scripts/send-clear takes text out of the orchestrator's input box, scripts/editor saves the text to
.loop/unsent/, and the input box comes back empty. At any other time, scripts/editor opens the maintainer's own
editor: $VISUAL, or else $EDITOR, or else vi.
"""

import os
import shlex
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent / "lib"))
import usage

UNSENT = usage.LOOP / "unsent"


def main() -> int:
    if len(sys.argv) != 2 or sys.argv[1] in ("-h", "--help"):
        print(__doc__)
        return 0 if len(sys.argv) == 2 else 2
    path = Path(sys.argv[1])
    if not usage.TAKING_INPUT.exists():
        editor = shlex.split(os.environ.get("LOOP_EDITOR") or "vi")
        os.execvp(editor[0], [*editor, str(path)])
    if text := path.read_text().strip():
        UNSENT.mkdir(parents=True, exist_ok=True)
        (UNSENT / f"{time.strftime('%Y-%m-%d-%H%M%S')}.txt").write_text(text + "\n")
    path.write_text("")
    usage.TAKING_INPUT.unlink(missing_ok=True)
    return 0


if __name__ == "__main__":
    sys.exit(main())
