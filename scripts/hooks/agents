#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.12"
# ///
"""SubagentStart and SubagentStop hooks that keep the registry of running agents in .loop/agents/.

usage: scripts/hooks/agents start|stop

scripts/meter counts the agents on each account from it, and tells the newest ones to wind down.
"""

import json
import os
import shutil
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import measurements
import usage


def main() -> None:
    event = json.load(sys.stdin)
    agent_id = event["agent_id"]
    path = usage.AGENTS / f"{agent_id}.json"
    if sys.argv[1] == "start":
        account = usage.account_of(dict(os.environ))
        agent_type = event.get("agent_type", "")
        usage.save_agent(
            {
                "id": agent_id,
                "name": agent_type,
                "config": usage.agent_config(agent_type),
                "account": account,
                "started": time.time(),
                "transcript": str(
                    Path(event["transcript_path"]).with_suffix("") / "subagents" / f"agent-{agent_id}.jsonl"
                ),
            }
        )
    elif path.exists():
        agent = json.loads(path.read_text())
        agent["stopped"] = time.time()
        usage.save_agent(agent)
        if "told_to_wind_down" in agent:
            measurements.record(f"reaction/{agent['config']}", (agent["stopped"] - agent["told_to_wind_down"]) / 60)
        shutil.rmtree(usage.NOTICES / agent_id, ignore_errors=True)


if __name__ == "__main__":
    main()
