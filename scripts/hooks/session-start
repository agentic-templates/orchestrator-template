#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.12"
# ///
"""A SessionStart hook that gives the orchestrator its skills, its saved state and the loop's status.

usage: scripts/hooks/session-start skills <provider>
       scripts/hooks/session-start state
       scripts/hooks/session-start status

It runs at startup, on resume, after /clear and after compaction. It does nothing in a session of another
agent type, such as a builder that scripts/launch started. A hook can inject at most 10,000 characters, so
the skills, the state and the status come from separate hooks. A new session also drops the refresh that the
session before it requested.
"""

import json
import os
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent.parent
sys.path.insert(0, str(ROOT / "scripts" / "lib"))
import refreshing
import usage

MAX_CHARACTERS = 10_000
# scripts/orchestrate sets LOOP_ORCHESTRATE. Without it, the session runs outside tmux or inside the sandbox.
NOT_ORCHESTRATED = (
    "This orchestrator wasn't started with scripts/orchestrate, so refreshing its context or starting agents may "
    "fail. Quit it, and start it again with scripts/orchestrate."
)
NOT_ORCHESTRATED_CONTEXT = (
    "You weren't started with scripts/orchestrate, so refreshes and agent launches may fail. Tell the maintainer "
    "to start you again with scripts/orchestrate, and start no agents until then."
)
# A worktree of the checkout shares its .loop folder, so only a separate clone has records of its own.
ANOTHER_ORCHESTRATOR_CONTEXT = (
    "Another orchestrator runs in this checkout, as process {pid}, so this session isn't the orchestrator. Tell the "
    "maintainer to quit this session, and to open sessions for work of their own in a separate clone of the "
    "repository."
)
LONG_STATES_TO_REPORT = 2
LONG_STATE_NOTE = (
    f"Your saved state was over {refreshing.LONG_STATE:,} characters at each of the last {LONG_STATES_TO_REPORT} "
    "refreshes. Send the maintainer a notification saying so, without quoting it, so that they can look at "
    ".loop/state.md."
)


def skill(name: str) -> str:
    return usage.without_front_matter((ROOT / ".agents" / "skills" / name / "SKILL.md").read_text())


def take_over(provider: str) -> None:
    """Records the orchestrator's account, and the tmux pane that scripts/send-clear types /clear into. Also
    forgets the refresh request, the failed refresh and the notices of the session before."""
    usage.LOOP.mkdir(exist_ok=True)
    account = usage.account_of(dict(os.environ), provider)
    pid = usage.this_session()
    record = {
        "account": account,
        "pane": os.environ.get("TMUX_PANE"),
        "pid": pid,
        "started": pid and usage.started_at(pid),
    }
    usage.write_atomically(usage.ORCHESTRATOR, json.dumps(record))
    refreshing.forget_last_session()


def state() -> str:
    if not refreshing.STATE.exists():
        return "No saved state: .loop/state.md doesn't exist."
    long_note = ""
    if refreshing.LONG_STATES.exists() and int(refreshing.LONG_STATES.read_text()) >= LONG_STATES_TO_REPORT:
        refreshing.LONG_STATES.unlink()
        long_note = LONG_STATE_NOTE + "\n\n"
    saved = refreshing.STATE.read_text().strip()
    before = long_note + "# Your saved state (.loop/state.md)\n\n"
    if len(before) + len(saved) > MAX_CHARACTERS:
        cut = "\n\n[This is the first part of .loop/state.md. Read the rest of the file.]"
        saved = saved[: MAX_CHARACTERS - len(before) - len(cut)] + cut
    return before + saved


def status() -> str:
    result = subprocess.run(
        [str(ROOT / "scripts" / "status"), "--save"], capture_output=True, text=True, check=False, cwd=ROOT
    )
    return status_context(result.returncode, result.stdout, result.stderr)


def status_context(code: int, output: str, errors: str) -> str:
    """What scripts/status printed, under a heading that says when it failed, so that the orchestrator doesn't take
    an error for the loop's status."""
    if code == 0:
        return f"# The loop's status\n\n{output}"
    return f"# scripts/status --save failed with exit status {code}\n\n{output}{errors}"


def respond(context: str, message: str | None = None) -> None:
    """Gives the model the context, and shows the maintainer the message, if any."""
    if len(context) > MAX_CHARACTERS:
        context = (
            context[: MAX_CHARACTERS - 100]
            + f"\n\n[The rest is cut, at the hook's limit of {MAX_CHARACTERS:,} characters.]"
        )
    output = {"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": context}}
    print(json.dumps(output | ({"systemMessage": message} if message else {})))


def main() -> None:
    event = json.load(sys.stdin)
    if event.get("agent_type") not in (None, "orchestrator"):
        return
    if other := usage.orchestrator_elsewhere():
        if sys.argv[1] == "skills":
            respond(ANOTHER_ORCHESTRATOR_CONTEXT.format(pid=other))
        return
    if sys.argv[1] == "skills":
        take_over(sys.argv[2])
        context = "\n\n".join(skill(name) for name in usage.orchestrator_skills(sys.argv[2]))
        if not os.environ.get("LOOP_ORCHESTRATE"):
            respond(NOT_ORCHESTRATED_CONTEXT + "\n\n" + context, NOT_ORCHESTRATED)
            return
    elif sys.argv[1] == "state":
        context = state()
    else:
        context = status()
    respond(context)


if __name__ == "__main__":
    main()
