#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.12"
# ///
"""A SessionStart hook that gives the orchestrator its skills, its saved state and the loop's status.

usage: scripts/hooks/session-start skills <provider>
       scripts/hooks/session-start state

It runs at startup, on resume, after /clear and after compaction. It does nothing in a session of another
agent type, such as a builder that scripts/launch started. A hook can inject at most 10,000 characters, so
the skills and the state come from two separate hooks.
"""

import json
import os
import subprocess
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent.parent
sys.path.insert(0, str(ROOT / "scripts" / "lib"))
import usage

STATE = ROOT / ".loop" / "state.md"
MAX_CHARACTERS = 10_000


def skill(name: str) -> str:
    text = (ROOT / ".agents" / "skills" / name / "SKILL.md").read_text()
    return text.split("---", 2)[2].strip() if text.startswith("---") else text


def take_over(provider: str) -> None:
    """Records the orchestrator's account, and marks the subagents of an earlier session as stopped,
    because they ran in its process."""
    usage.LOOP.mkdir(exist_ok=True)
    usage.ORCHESTRATOR.write_text(json.dumps({"account": usage.account_of(dict(os.environ), provider)}))
    for agent in usage.running_agents():
        if "pid" not in agent:
            agent["stopped"] = time.time()
            usage.save_agent(agent)


def state() -> str:
    saved = STATE.read_text().strip() if STATE.exists() else "No saved state. This is the loop's first session."
    status = subprocess.run(
        [str(ROOT / "scripts" / "status"), "--save"], capture_output=True, text=True, check=False, cwd=ROOT
    )
    return f"# Your saved state (.loop/state.md)\n\n{saved}\n\n# The loop's status\n\n{status.stdout or status.stderr}"


def main() -> None:
    event = json.load(sys.stdin)
    if event.get("agent_type") not in (None, "orchestrator"):
        return
    if sys.argv[1] == "skills":
        take_over(sys.argv[2])
        context = skill("orchestrator") + "\n\n" + skill(f"orchestrator-{sys.argv[2]}")
    else:
        context = state()
    if len(context) > MAX_CHARACTERS:
        context = context[: MAX_CHARACTERS - 100] + "\n\n[Cut here. Run scripts/status for the rest.]"
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": context}}))


if __name__ == "__main__":
    main()
