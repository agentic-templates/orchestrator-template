#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.12"
# ///
"""A PostToolBatch hook that tells an agent once to wind down, when scripts/meter has marked it in .loop/wind-down/.

The settings run it only while that folder exists. A builder that scripts/launch started finds its ID in
LOOP_AGENT_ID, and a subagent in the hook's input.
"""

import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import usage

NOTICE = (
    "Wind down: the account is close to its usage limit. Finish the step you're on, commit, push the branch, "
    "and end with your report, saying what's left. Don't start another step."
)


def main() -> None:
    event = json.load(sys.stdin)
    agent_id = os.environ.get("LOOP_AGENT_ID") or event.get("agent_id")
    flag = usage.WIND_DOWN / str(agent_id)
    told = flag.with_suffix(".told")
    if agent_id and flag.exists() and not told.exists():
        told.touch()
        print(json.dumps({"hookSpecificOutput": {"hookEventName": "PostToolBatch", "additionalContext": NOTICE}}))


if __name__ == "__main__":
    main()
