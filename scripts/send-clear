#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.12"
# ///
"""Once the orchestrator's session is idle, types /clear into its terminal, and then "Continue the loop." into the
new session.

The Stop hook scripts/hooks/refresh starts it once the orchestrator has requested a refresh with scripts/refresh
--ready, and scripts/watch starts it again if the refresh hasn't happened. It types only into the tmux pane that the
orchestrator's session started in, and only while no turn runs and no dialog shows. It waits while:

- the maintainer wrote to the orchestrator in the last {active_minutes} minutes. It stops waiting for this once the
  orchestrator's context passes the point where the orchestrator refreshes even while the maintainer writes to it.
- the maintainer has text typed in the input box. Text left unchanged for {abandoned_seconds} seconds counts as
  abandoned. scripts/send-clear moves it to .loop/unsent/ with Ctrl+G and scripts/editor, and the new session never
  sees it. If Ctrl+G leaves the text in the input box, scripts/send-clear deletes it.

It tells whether a turn is running from the transcript as well as the screen, because Claude Code hides its
spinner while it writes a long answer.

It writes what it waits for to .loop/refresh-waiting, and stops when a tool call after the request cancels the
refresh. If it can't type into the terminal, it says why in .loop/refresh-waiting and stops.
"""

import argparse
import json
import os
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent / "lib"))
import contexts
import refreshing
import terminal
import usage
import watching

TYPED = usage.LOOP / "refresh-typed.json"
CHECK_SECONDS = 10
# Text in the box that stays the same this long was left there, rather than being written.
ABANDONED_SECONDS = 120
# How long scripts/editor may take to start and take the text. It starts through uv, which takes longer when its
# cache is empty.
EDITOR_SECONDS = 30
# How long the new session may take to start and become idle after /clear.
START_SECONDS = 60


class CantSend(Exception):
    """The sender can't type into the orchestrator's terminal, for the reason it gives."""


class CantContinue(Exception):
    """/clear started a new session, but the sender can't type "Continue the loop." into it."""


def tmux(*args: str) -> str:
    result = subprocess.run(["tmux", *args], capture_output=True, text=True, check=False)
    if result.returncode != 0:
        raise CantSend(f"tmux {args[0]} failed: {result.stderr.strip()}")
    return result.stdout


def screen(pane: str) -> terminal.Screen:
    return terminal.read(tmux("capture-pane", "-p", "-e", "-t", pane))


def type_text(pane: str, text: str) -> None:
    tmux("send-keys", "-t", pane, "-l", text)


def press(pane: str, *keys: str) -> None:
    tmux("send-keys", "-t", pane, *keys)


def wait_one_check(reason: str) -> None:
    """Records in .loop/refresh-waiting why the sender waits, and waits until its next check."""
    refreshing.WAITING.write_text(reason + "\n")
    time.sleep(CHECK_SECONDS)


def should_wait_for_maintainer() -> bool:
    """Whether the refresh waits for the maintainer, who wrote to the orchestrator within the last
    watching.ACTIVE_MINUTES, while the orchestrator's context is below the point where it refreshes even then."""
    if not watching.is_maintainer_active():
        return False
    orchestrator = usage.orchestrator()
    context = contexts.load(watching.CONTEXTS).get(str(orchestrator.get("transcript")))
    if context is None:
        return True
    limits = watching.session_thresholds(context, orchestrator.get("account"), orchestrator.get("window"))
    return limits is None or context.current < limits.while_active


def is_abandoned(text: str, request_time: float) -> bool:
    """Whether the box has shown the same text for long enough since the refresh was requested. The time counts
    across senders, such as the watcher's retry, but starts again at a new request, because the maintainer may type
    the same short text, such as "ok", again."""
    typed: dict = json.loads(TYPED.read_text()) if TYPED.exists() else {}
    if typed.get("text") != text or typed.get("request") != request_time:
        typed = {"text": text, "request": request_time, "since": time.time()}
        TYPED.write_text(json.dumps(typed))
    return time.time() - typed["since"] >= ABANDONED_SECONDS


def take_text(pane: str) -> None:
    """Moves the box's text to .loop/unsent/ through the editor that Ctrl+G opens, or deletes it if that fails."""
    usage.TAKING_INPUT.touch()
    try:
        press(pane, "C-g")
        wait_for_editor()
    finally:
        # Left behind, it would make the maintainer's own Ctrl+G take their text too.
        usage.TAKING_INPUT.unlink(missing_ok=True)
    if screen(pane).box:
        # The maintainer chose losing the text here over stalling the refresh: it's rare, and usually forgotten.
        # Ctrl+C would clear the box too, but on an empty box it starts to quit Claude Code.
        press(pane, "-N", "2000", "BSpace")
        time.sleep(1)
    # No box at all means the editor or a dialog still shows, so the text isn't taken either.
    if screen(pane).box != "":
        raise CantSend("text in the input box couldn't be taken out of it. Empty the input box by hand")
    TYPED.unlink(missing_ok=True)


def wait_for_editor() -> None:
    """Waits until scripts/editor has taken the box's text, which it says by deleting .loop/taking-input."""
    deadline = time.time() + EDITOR_SECONDS
    while usage.TAKING_INPUT.exists():
        if time.time() >= deadline:
            raise CantSend(
                f"scripts/editor didn't take the text in the input box within {EDITOR_SECONDS} seconds of Ctrl+G. "
                "If an editor shows in the orchestrator's pane, close it, and empty the input box by hand"
            )
        time.sleep(0.5)


def is_busy(shown: terminal.Screen) -> bool:
    transcript = usage.orchestrator().get("transcript")
    return shown.is_busy or bool(transcript and refreshing.turn_running(Path(transcript)))


def get_ready(pane: str, request_time: float) -> bool:
    """Whether the session is idle with an empty input box. When it isn't, this waits one check and records why, or
    takes the maintainer's abandoned text out of the input box."""
    shown = screen(pane)
    if is_busy(shown):
        wait_one_check("a turn is running")
    elif shown.box is None:
        wait_one_check("a dialog is open")
    elif should_wait_for_maintainer():
        wait_one_check(f"the maintainer wrote to the orchestrator in the last {watching.ACTIVE_MINUTES} minutes")
    elif shown.box and not is_abandoned(shown.box, request_time):
        wait_one_check("the maintainer has text in the input box")
    elif shown.box:
        take_text(pane)
        return False
    else:
        return True
    return False


def send(pane: str, text: str) -> bool:
    """Types the text and presses Enter, if the box shows exactly that text and the session is still idle."""
    type_text(pane, text)
    time.sleep(1)
    shown = screen(pane)
    if shown.box != text or is_busy(shown):
        press(pane, "-N", str(len(text)), "BSpace")
        return False
    press(pane, "Enter")
    return True


def clear(pane: str) -> None:
    while (saved := refreshing.load_request()) and not refreshing.is_cancelled(saved):
        if get_ready(pane, saved["time"]) and send(pane, "/clear"):
            break
    else:
        return
    # The new session's start hook removes the request. A notice that waited can start a turn of its own.
    deadline = time.time() + START_SECONDS
    while time.time() < deadline:
        time.sleep(2)
        shown = screen(pane)
        if not refreshing.REQUEST.exists() and is_busy(shown):
            return
        if not refreshing.REQUEST.exists() and shown.box == "" and send(pane, "Continue the loop."):
            return
    if refreshing.REQUEST.exists():
        raise CantSend(f"/clear didn't start a new session within {START_SECONDS} seconds")
    raise CantContinue(
        '/clear started a new session, but "Continue the loop." couldn\'t be typed into it. Type "Continue the loop." '
        "into the orchestrator's session and press Enter"
    )


def main() -> int:
    description = __doc__.format(active_minutes=watching.ACTIVE_MINUTES, abandoned_seconds=ABANDONED_SECONDS)
    argparse.ArgumentParser(
        prog="scripts/send-clear", description=description, formatter_class=argparse.RawDescriptionHelpFormatter
    ).parse_args()
    if usage.running_sender():
        return 0
    usage.SENDER_PID.write_text(str(os.getpid()))
    try:
        pane = usage.orchestrator().get("pane")
        if not pane:
            raise CantSend(
                "the orchestrator doesn't run in tmux. The maintainer has to start it again with scripts/orchestrate"
            )
        clear(pane)
        refreshing.WAITING.unlink(missing_ok=True)
    except CantSend as error:
        refreshing.WAITING.write_text(f"can't send /clear: {error}\n")
        return 1
    except CantContinue as error:
        refreshing.WAITING.write_text(f"{error}\n")
        return 1
    finally:
        usage.SENDER_PID.unlink(missing_ok=True)
    return 0


if __name__ == "__main__":
    sys.exit(main())
