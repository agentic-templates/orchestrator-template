#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.12"
# ///
"""Runs the formatters and linters on the files that the branch changes, or on every file with --all, and the tests and
type checkers on the whole project.

usage: scripts/check [--all] [--base <commit>] [--review]

Without --base, the branch's changes are counted from where it left origin/main, together with
uncommitted and untracked files. With --review, it lists what a reviewer should judge, such as functions
that are hard to follow, and doesn't fail. Each check prints "<file>:<line>: <what to do>". The exit status is 1
when any check fails.

To add a language, add its formatter and linter to TOOLS and its type checker and tests to TESTS, as the `languages`
skill describes.
"""

import argparse
import subprocess
import sys
from pathlib import Path
from typing import NamedTuple

sys.path.insert(0, str(Path(__file__).parent / "lib"))
import files
import prose

ROOT = Path(__file__).resolve().parent.parent


class Tool(NamedTuple):
    kind: str
    command: list[str]
    # Printed after the tool's own output when it fails.
    hint: str = ""


COMPLEXIPY_FIXED_SETTINGS = [
    "--ignore-complexity=false",
    "--snapshot-create=false",
    "--snapshot-ignore",
    "--staged=false",
]

# Each tool runs once, on the changed files of its kind, with the files appended to its command. The loop-python
# tools take their settings from scripts/ruff.toml and their own flags, so that a project's settings, such as a ruff
# section in its pyproject.toml, don't change the loop's checks. complexipy reads its settings from the pyproject.toml
# or complexipy.toml at the repository's root, so COMPLEXIPY_FIXED_SETTINGS overrides each setting that could let a
# function over the limit pass or stay out of the report, except two that no flag overrides. A project's quiet = true
# hides the list of functions over the limit, though the check still fails. A project's branch in
# [tool.complexipy.diff] fails the check only on functions whose complexity rose against that branch.
TOOLS = [
    Tool("loop-python", ["uvx", "ruff@0.17.0", "check", "--quiet", "--config", "scripts/ruff.toml"]),
    Tool("loop-python", ["uvx", "ruff@0.17.0", "format", "--check", "--quiet", "--config", "scripts/ruff.toml"]),
    Tool(
        "loop-python",
        [
            "uvx",
            "complexipy@8.0.1",
            "--max-complexity-allowed",
            "25",
            "--failed",
            "--plain",
            *COMPLEXIPY_FIXED_SETTINGS,
        ],
        "These functions are over the cognitive-complexity limit. Change a function only where the change makes it"
        " easier to read. If every change you can find would make the function harder to read, leave the function as"
        " it is, and end its `def` line with `# complexipy: ignore because <why the function reads best as it is>`.",
    ),
    Tool("workflow", ["uvx", "--from", "actionlint-py@1.7.12.25", "actionlint"]),
    Tool("workflow", ["uvx", "zizmor@1.30.1", "--offline", "--quiet"]),
    Tool("any", ["uvx", "typos@1.51.1"]),
]
# With --review, these run instead, and list what a reviewer should judge without failing the check.
# A function's cognitive complexity fails the check at 25, and a reviewer sees it from 15.
REVIEW_TOOLS = [
    Tool(
        "loop-python",
        [
            "uvx",
            "complexipy@8.0.1",
            "--max-complexity-allowed",
            "15",
            "--failed",
            "--plain",
            *COMPLEXIPY_FIXED_SETTINGS,
        ],
    ),
]
# Each command runs once at every check, on the whole project. PYTHONSAFEPATH stops Python from putting the current
# folder first on its import path. Without it, a project's own module, such as a signal.py at the repository's root,
# replaces the standard library's module of the same name in the loop's tests and the processes they start.
TESTS = [
    [
        "env",
        "PYTHONSAFEPATH=1",
        "uv",
        "run",
        "--no-project",
        "--python",
        "3.12",
        "python",
        "-m",
        "unittest",
        "discover",
        "-s",
        "scripts/lib",
    ],
]
# The type checker ty runs with the tests, on every loop-python file, because a change can break a caller in a file it
# doesn't touch. It gets the files by name, because in a folder it skips the files without .py. --project scripts makes
# ty read scripts/ty.toml instead of the settings at the repository's root. It also keeps a json.py at the repository's
# root from replacing the standard library's json, because ty looks for the project's own modules in the project's
# folder first. --extra-search-path is on the command line, because ty reads a config file's extra-paths relative to
# each PEP 723 script's own folder.
LOOP_TY = ["uvx", "ty@0.0.91", "check", "--project", "scripts", "--extra-search-path", "scripts/lib"]


def git(*args: str) -> list[str]:
    output = subprocess.run(["git", *args], cwd=ROOT, check=True, capture_output=True, text=True).stdout
    return [line for line in output.splitlines() if line]


def changed_files(base: str | None) -> list[str]:
    if base is None:
        base = git("merge-base", "origin/main", "HEAD")[0]
        local = git("diff", "--name-only", "--diff-filter=d", "HEAD") + git(
            "ls-files", "--others", "--exclude-standard"
        )
    else:
        local = []
    return sorted(set(git("diff", "--name-only", "--diff-filter=d", base, "HEAD") + local))


def regular_files(paths: list[str]) -> list[str]:
    return [path for path in paths if (ROOT / path).is_file() and not (ROOT / path).is_symlink()]


def kind(path: str) -> str:
    if path.startswith(".github/workflows/") and path.endswith(".yml"):
        return "workflow"
    if not is_python(path):
        return "other"
    return "loop-python" if path.startswith("scripts/") else "python"


def is_python(path: str) -> bool:
    if path.endswith(".py"):
        return True
    with open(ROOT / path, "rb") as file:
        first_line = file.readline()
    return first_line.startswith(b"#!") and (b"python" in first_line or b"uv run" in first_line)


def check_files(paths: list[str]) -> list[str]:
    problems = []
    for path in paths:
        try:
            text = (ROOT / path).read_text()
        except UnicodeDecodeError:
            continue
        found = files.check_name(path) + files.check_text(path, text)
        if path.endswith(".md"):
            found += prose.check(text)
        problems += [f"{path}:{problem.line}: {problem.message}" for problem in found]
    return problems


def run_tools(paths: list[str], tools: list = TOOLS, tests: list = TESTS) -> bool:
    kinds = {path: kind(path) for path in paths}
    passed = True
    for tool in tools:
        targets = [path for path in paths if tool.kind in ("any", kinds[path])]
        if targets and subprocess.run([*tool.command, *targets], check=False, cwd=ROOT).returncode != 0:
            passed = False
            if tool.hint:
                print(tool.hint, flush=True)
    for command in tests:
        if subprocess.run(command, check=False, cwd=ROOT).returncode != 0:
            passed = False
    return passed


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--all", action="store_true", help="check every file")
    parser.add_argument("--base", help="count the changes from this commit")
    parser.add_argument("--review", action="store_true", help="list what a reviewer should judge, without failing")
    arguments = parser.parse_args()
    paths = regular_files(git("ls-files") if arguments.all else changed_files(arguments.base))
    if arguments.review:
        run_tools(paths, REVIEW_TOOLS, tests=[])
        return 0
    problems = check_files(paths)
    print("\n".join(problems), end="\n" if problems else "", flush=True)
    loop_python = [path for path in regular_files(git("ls-files", "scripts")) if kind(path) == "loop-python"]
    tools_passed = run_tools(paths, tests=[*TESTS, [*LOOP_TY, *loop_python]])
    return 0 if tools_passed and not problems else 1


if __name__ == "__main__":
    sys.exit(main())
