#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.12"
# ///
"""Starts an agent in a worktree of its own, waits until it's done, and prints its report.

usage: scripts/launch <agent type> <issue or pull request> [--account <name>] [--second-review] [--successor]
       scripts/launch --resume <agent ID> --message <message>

Run it in the background: its exit wakes the orchestrator. The agent runs as a headless session of its own, so
that the orchestrator's refreshes and crashes don't touch it, and scripts/message can still reach it while it
works. It starts on the account that scripts/meter names, or on the one --account names if the meter gives that
account room.

- A builder, which is any agent type that preloads the building skill, gets the issue's number and its branch
  issue-<number> checked out. With --successor, it continues the issue from the hand-off note that the builder
  before it wrote, on the same branch.
- A reviewer gets the pull request's number, and --second-review for its second review.
- A researcher gets the research issue's number.
- With --resume, an agent that has stopped continues its own session, with its whole context, from the message,
  such as a builder given its review's errors.

The agent is done once it has given its report, nothing has come from it for a minute, and it runs no command in
the background. The launcher then stops it, commits and pushes any work left in its worktree, and prints its
report. Stopping the launcher does the same.
"""

import argparse
import json
import os
import signal
import sys
import time
import uuid
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent / "lib"))
import launching
import metering
import usage


def prompt_for(arguments: argparse.Namespace) -> str:
    number = arguments.number
    if arguments.agent_type.startswith("reviewer"):
        review = "second" if arguments.second_review else "first"
        return f"Review pull request #{number}. This is its {review} review."
    if arguments.agent_type == "researcher":
        return f"Answer research issue #{number}."
    if arguments.successor:
        note = usage.LOOP / "handoff" / f"issue-{number}.md"
        if not note.exists():
            return (
                f"Continue issue #{number}. The builder before you stopped without a hand-off note, and its work is on "
                "your branch. Start from `git log` and the issue."
            )
        return f"Continue issue #{number}. The builder before you handed off with this note:\n\n{note.read_text()}"
    return f"Build issue #{number}."


def parse() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("agent_type", nargs="?")
    parser.add_argument("number", type=int, nargs="?")
    parser.add_argument("--account")
    parser.add_argument("--second-review", action="store_true")
    parser.add_argument("--successor", action="store_true")
    parser.add_argument("--force", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--resume", metavar="AGENT_ID")
    parser.add_argument("--message")
    arguments = parser.parse_args()
    if arguments.resume and not arguments.message:
        parser.error("--resume needs --message, the message the agent continues from.")
    if not arguments.resume and (arguments.agent_type is None or arguments.number is None):
        parser.error("Give an agent type and an issue or pull request number, or --resume.")
    return arguments


def resume(arguments: argparse.Namespace) -> int:
    record = json.loads((usage.AGENTS / f"{arguments.resume}.json").read_text())
    account = next(a for a in usage.accounts() if a.name == record["account"])
    worktree = Path(record["worktree"])
    if not worktree.exists():
        worktree = launching.make_worktree(record["id"], f"issue-{record['number']}", continues=True)
    session = launching.start(account, record["name"], record["id"], worktree, arguments.message, record["session"])
    return run(session, {**record, "started": time.time(), "pid": os.getpid(), "worktree": str(worktree)})


def run(session: launching.Session, record: dict) -> int:
    record.pop("stopped", None)
    record.pop("told_to_wind_down", None)
    signal.signal(signal.SIGTERM, lambda *_: launching.finish(session, "stopped"))
    usage.save_agent(record)
    print(launching.wait(session, record))
    return 0


def main() -> int:
    arguments = parse()
    if arguments.resume:
        return resume(arguments)
    decisions = metering.decisions()
    account, reason = launching.choose_account(decisions, usage.accounts(), arguments.account, arguments.force)
    if account is None:
        print(reason)
        return 2
    agent_id = f"{arguments.agent_type}-{arguments.number}-{uuid.uuid4().hex[:6]}"
    session_id = str(uuid.uuid4())
    worktree = launching.WORKTREES / agent_id
    record = {
        "id": agent_id,
        "name": arguments.agent_type,
        "config": usage.agent_config(arguments.agent_type),
        "account": account.name,
        "number": arguments.number,
        "session": session_id,
        "started": time.time(),
        "pid": os.getpid(),
        "worktree": str(worktree),
        "transcript": str(launching.transcript_path(account, worktree, session_id)),
    }
    # Saved before the agent starts, so that the meter counts it for a launch that comes right after this one.
    usage.save_agent(record)
    builds = "building" in usage.agent_skills(arguments.agent_type)
    branch = f"issue-{arguments.number}" if builds else None
    launching.make_worktree(agent_id, branch, continues=arguments.successor)
    session = launching.start(account, arguments.agent_type, agent_id, worktree, prompt_for(arguments), session_id)
    return run(session, record)


if __name__ == "__main__":
    sys.exit(main())
